{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm run format:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run start:dev:*)",
      "Bash(npm run test:*)",
      "Bash(npm run migration:*)",
      "Bash(npm run seed:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx nest:*)",
      "Bash(docker compose:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(pnpm start:dev:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm migration:*)",
      "Bash(pnpm seed:*)",
      "Bash(pnpm exec:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm publish:*)",
      "Bash(yarn:*)"
    ]
  }
}
