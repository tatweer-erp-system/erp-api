NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SUPER_ADMIN_IPS=127.0.0.1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp_user
DB_PASS=secret
DB_NAME=erp_shared

# Read Replica (optional)
DB_READ_HOST=
DB_READ_PORT=5432

# ─── Feature Flags (set to true to enable) ────────────────────────────────────
CACHE_ENABLED=false
QUEUES_ENABLED=false
MONGODB_ENABLED=false
FIREBASE_ENABLED=false
MAIL_ENABLED=false
STORAGE_ENABLED=false

# Redis Cache
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6379

# Redis Queue (BullMQ)
REDIS_QUEUE_HOST=localhost
REDIS_QUEUE_PORT=6380

# MongoDB (optional secondary DB for logs/notifications)
MONGODB_URI=
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_NAME=erp_logs

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

# Firebase (FCM push notifications) — requires FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Storage (S3-compatible) — requires STORAGE_ENABLED=true
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=erp-uploads
AWS_REGION=us-east-1

# Mail (SMTP) — requires MAIL_ENABLED=true + QUEUES_ENABLED=true
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASS=
MAIL_FROM=noreply@erp.com

# SMS (Twilio) — requires QUEUES_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Sentry (error tracking)
SENTRY_DSN=

# i18n
DEFAULT_LANG=en
SUPPORTED_LANGS=en,ar

# Payment
PAYMENT_PROVIDER=moyasar
PAYMENT_CURRENCY=SAR
TRIAL_DAYS=14
DEFAULT_TRIAL_DAYS=14
MOYASAR_SECRET_KEY=sk_test_
MOYASAR_PUBLISHABLE_KEY=pk_test_
MOYASAR_CALLBACK_URL=http://localhost:3000/api/v1/subscriptions/payment/callback

# CORS
CORS_ORIGINS=http://localhost:3001

# Field Encryption
FIELD_ENCRYPTION_KEY=32-char-hex-string-here

# OpenTelemetry
OTEL_EXPORTER=jaeger
OTEL_ENDPOINT=http://localhost:14268/api/traces
OTEL_SERVICE_NAME=erp-backend

# Retention & Outbox
RETENTION_CRON=0 2 * * *
OUTBOX_POLL_INTERVAL=10000

# Idempotency
IDEMPOTENCY_TTL=86400

# Webhook
WEBHOOK_SIGNING_SECRET=
